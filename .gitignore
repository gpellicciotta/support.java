# Gradle
.gradle/
build/
out/

# Compiled class files
*.class
bin/

# Local environment secrets
.env
**/*.env

# Python
__pycache__/
*.pyc

# IDE/editor
# Shared IntelliJ config is checked in; only volatile per-user/local files are ignored.
.idea/workspace.xml
.idea/dataSources.local.xml
.idea/shelf/
.idea/sonarlint/
# Share portable VS Code settings; ignore other editor-local files.
**/.vscode/*
!**/.vscode/settings.json
*.iml

# Task worktrees (git worktree add ./work/Tnnnn-slug)
work/

# Logs
*.log
log/
