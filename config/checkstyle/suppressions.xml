<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN" "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Tests are not public API: brace rules apply, Javadoc and package-info rules do not. -->
  <suppress checks="MissingJavadoc.*|JavadocVariable|JavadocPackage" files="[\/]src[\/]test[\/]"/>
</suppressions>
