<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Enforces the dev-guidelines Java rules that Spotless cannot: Stroustrup braces, braces on every control
     block, Javadoc on the public API, and a package-info.java per package. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/suppressions.xml"/>
  </module>

  <module name="JavadocPackage"/>

  <module name="TreeWalker">
    <!-- Stroustrup: opening braces end the line; else, catch, and finally start a new line. -->
    <module name="LeftCurly">
      <property name="option" value="eol"/>
    </module>
    <module name="RightCurly">
      <property name="option" value="alone_or_singleline"/>
    </module>
    <module name="NeedBraces"/>

    <!-- Document all public API surface (public and protected members of public types). -->
    <module name="MissingJavadocType">
      <property name="scope" value="protected"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="protected"/>
    </module>
    <module name="JavadocVariable">
      <property name="accessModifiers" value="public, protected"/>
    </module>
  </module>
</module>
