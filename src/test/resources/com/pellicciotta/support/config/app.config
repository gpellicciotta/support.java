<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configuration xmlns:xi="http://www.w3.org/2001/XInclude">

  <string-a>The USERNAME is ${env:USERNAME}</string-a>
  <boolean-b>off</boolean-b>
  <byte-size-c>2.5GB</byte-size-c>
  <long-d>987654321</long-d>
  <date-time-e>2020-03-04T05:06:07</date-time-e>
  <enum-f>run</enum-f>

  <web>
    <http-port>8080</http-port>
    <https-port>8081</https-port>
    <host>apps.pellicciotta.com</host>
  </web>

  <logging>
    <level>info</level>
    <prefix>A custom prefix</prefix>
    <include-stack-traces>off</include-stack-traces>
    <logger name="com" level="info" />
    <logger name="foo" level="debug" />
  </logging>

</configuration>
